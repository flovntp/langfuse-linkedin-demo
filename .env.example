# ── Langfuse ────────────────────────────────────────────────────────────────
# Local self-hosted (npm run langfuse:up): these demo keys are created for you
# on first start (headless initialization). They only work on localhost.
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-local-demo
LANGFUSE_SECRET_KEY=sk-lf-local-demo
# Langfuse Cloud instead: create a project on https://cloud.langfuse.com,
# copy its API keys above and set LANGFUSE_BASE_URL=https://cloud.langfuse.com
# (or https://us.cloud.langfuse.com).

# Login for the local Langfuse UI (created on first start)
LANGFUSE_INIT_USER_EMAIL=demo@example.com
LANGFUSE_INIT_USER_PASSWORD=change-me-please

# ── LLM providers ───────────────────────────────────────────────────────────
# Model used when --model is not given. Format: <provider>:<model>
#   anthropic:claude-haiku-5-5
#   lmstudio:google/gemma-3-12b
#   openrouter:google/gemma-3-12b-it
DEFAULT_MODEL=anthropic:claude-haiku-5-5

ANTHROPIC_API_KEY=

# LM Studio: Developer tab → Start server. Load the model with a context
# length of at least 16k tokens, the default 4k is too short for a blog post.
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# OpenRouter (optional): one key for many models, OpenAI-compatible API.
# New keys can have a $0 spending limit: raise it on openrouter.ai/settings/keys
# or every call fails with "403 Key limit exceeded".
OPENROUTER_API_KEY=

# ── Demo identity (shows up on every trace) ─────────────────────────────────
DEMO_USER_ID=devrel-demo
